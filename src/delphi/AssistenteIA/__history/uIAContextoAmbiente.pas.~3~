unit uIAContextoAmbiente;

interface

uses
  System.SysUtils,
  uIATipos,
  uIAContratos;

type
  TIAContextoAmbiente = class(TInterfacedObject, IIAContextoProvider)
  public
    function CriarContextoAtual: TIAContextoUsuario;
  end;

implementation

uses
  Unt_Conexao;

function TIAContextoAmbiente.CriarContextoAtual: TIAContextoUsuario;
var
  CodUsuario: string;
  CodFilial: string;
begin
  Result := TIAContextoUsuario.Create;

  try
    if not Assigned(dm_conexao) then
      raise Exception.Create(
        'O DataModule de conexao do ERP nao esta disponivel.');

    if not dm_conexao.SQL_EMPREGADO.Active then
      raise Exception.Create(
        'O cadastro do usuario logado ainda nao foi carregado.');

    if dm_conexao.SQL_EMPREGADO.IsEmpty then
      raise Exception.Create(
        'Nao foi possivel identificar o usuario logado no ERP.');

    CodUsuario :=
      Trim(
        dm_conexao.SQL_EMPREGADOCODFUNC.AsString
      );

    CodFilial :=
      Trim(
        dm_conexao.SQL_EMPREGADOCODFILIAL.AsString
      );

    if CodUsuario = '' then
      raise Exception.Create(
        'O codigo do usuario nao foi informado.');

    if CodFilial = '' then
      raise Exception.Create(
        'O codigo da filial nao foi informado.');

    Result.CodigoUsuario :=
      CodUsuario;

    Result.CodigoEmpresa :=
      Trim(dm_conexao.vsEMPRESA);

    Result.CodigoFilial := '01';

    Result.RotinaOrigem :=
      Trim(dm_conexao.vsCODPROG);

    Result.VersaoERP :=
      'Safer ERP';

    {
      Neste primeiro momento, inclui a filial atual como permitida.
      Depois podemos carregar todas as filiais permitidas pelo usuario.
    }
    Result.FiliaisPermitidas.Add(
      CodFilial
    );

    Result.Validar;

  except
    Result.Free;
    raise;
  end;
end;

end.
