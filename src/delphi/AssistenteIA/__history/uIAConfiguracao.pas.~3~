unit uIAConfiguracao;

interface

uses
  Winapi.Windows,
  System.SysUtils,
  System.Classes,
  System.IniFiles;

type
  TIAConfiguracao = class
  private
    FApiBaseUrl: string;
    FAccessToken: string;
    FTimeoutMs: Integer;

    function GetIniFileName: string;
  public
    constructor Create;

    procedure Load;
    procedure Save;
    procedure Validar;

    property ApiBaseUrl: string
      read FApiBaseUrl
      write FApiBaseUrl;

    property AccessToken: string
      read FAccessToken
      write FAccessToken;

    property TimeoutMs: Integer
      read FTimeoutMs
      write FTimeoutMs;
  end;

implementation

const
  C_PASTA_CONFIG = 'C:\Belt\Arquivos\Config';
  C_ARQUIVO_CONFIG = 'ia-api-local.ini';

{ TIAConfiguracao }

constructor TIAConfiguracao.Create;
begin
  inherited Create;

  FApiBaseUrl := 'http://127.0.0.1:8081';
  FAccessToken := '';
  FTimeoutMs := 60000;

  Load;
end;

function TIAConfiguracao.GetIniFileName: string;
begin
  if not DirectoryExists(C_PASTA_CONFIG) then
    ForceDirectories(C_PASTA_CONFIG);

  Result :=
    IncludeTrailingPathDelimiter(C_PASTA_CONFIG) +
    C_ARQUIVO_CONFIG;
end;

procedure TIAConfiguracao.Load;
var
  Ini: TIniFile;
  ValorAmbiente: string;
begin
  Ini := TIniFile.Create(GetIniFileName);
  try
    FApiBaseUrl :=
      Ini.ReadString(
        'API',
        'BaseUrl',
        FApiBaseUrl
      );

    FAccessToken :=
      Ini.ReadString(
        'API',
        'AccessToken',
        FAccessToken
      );

    FTimeoutMs :=
      Ini.ReadInteger(
        'API',
        'TimeoutMs',
        FTimeoutMs
      );
  finally
    Ini.Free;
  end;

  {
    Se houver variavel de ambiente,
    ela tem prioridade sobre o arquivo INI.
  }

  ValorAmbiente :=
    Trim(
      GetEnvironmentVariable(
        'ERP_IA_API_URL'
      )
    );

  if ValorAmbiente <> '' then
    FApiBaseUrl := ValorAmbiente;

  ValorAmbiente :=
    Trim(
      GetEnvironmentVariable(
        'ERP_IA_API_TOKEN'
      )
    );

  if ValorAmbiente <> '' then
    FAccessToken := ValorAmbiente;
end;

procedure TIAConfiguracao.Save;
var
  Ini: TIniFile;
begin
  if not DirectoryExists(C_PASTA_CONFIG) then
    ForceDirectories(C_PASTA_CONFIG);

  Ini := TIniFile.Create(GetIniFileName);
  try
    Ini.WriteString(
      'API',
      'BaseUrl',
      Trim(FApiBaseUrl)
    );

    Ini.WriteString(
      'API',
      'AccessToken',
      Trim(FAccessToken)
    );

    Ini.WriteInteger(
      'API',
      'TimeoutMs',
      FTimeoutMs
    );

    {
      Remove configuracao antiga protegida,
      caso ainda exista no arquivo.
    }
    Ini.DeleteKey(
      'API',
      'AccessTokenProtected'
    );
  finally
    Ini.Free;
  end;
end;

procedure TIAConfiguracao.Validar;
begin
  if Trim(FApiBaseUrl) = '' then
    raise EInvalidOpException.Create(
      'Informe a URL da API corporativa.'
    );

  if not SameText(
       Copy(FApiBaseUrl, 1, 8),
       'https://'
     ) and
     not SameText(
       Copy(FApiBaseUrl, 1, 17),
       'http://localhost'
     ) and
     not SameText(
       Copy(FApiBaseUrl, 1, 16),
       'http://127.0.0.1'
     ) then
  begin
    raise EInvalidOpException.Create(
      'A API deve utilizar HTTPS ou endereco local.'
    );
  end;

  if FTimeoutMs <= 0 then
    raise EInvalidOpException.Create(
      'Timeout invalido para a API de IA.'
    );
end;

end.
