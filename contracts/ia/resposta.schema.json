{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:erp:ia:resposta:v1",
  "title": "Resposta estruturada do assistente",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "conversation_id", "status", "answer", "knowledge_sufficient", "sources"],
  "properties": {
    "request_id": { "type": "string", "format": "uuid" },
    "conversation_id": { "type": "string", "format": "uuid" },
    "status": {
      "type": "string",
      "enum": ["answered", "knowledge_insufficient", "refused_out_of_scope", "error"]
    },
    "answer": { "type": "string" },
    "knowledge_sufficient": { "type": "boolean" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_type", "source_id", "title"],
        "properties": {
          "source_type": { "type": "string", "enum": ["knowledge", "tool", "view"] },
          "source_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "version": { "type": ["string", "null"] }
        }
      }
    },
    "suggested_action": { "type": ["string", "null"], "enum": ["teach_ai", null] },
    "knowledge_request_id": { "type": ["string", "null"], "format": "uuid" },
    "usage": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "cost": { "type": ["number", "null"], "minimum": 0 },
        "currency": { "type": ["string", "null"] }
      }
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "user_message"],
      "properties": {
        "code": { "type": "string" },
        "user_message": { "type": "string" },
        "correlation_id": { "type": ["string", "null"] }
      }
    }
  }
}
