{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:erp:ia:contexto-usuario:v1",
  "title": "Contexto mínimo do usuário",
  "type": "object",
  "additionalProperties": false,
  "required": ["user_code", "company_code", "branch_code", "allowed_branch_codes", "erp_version"],
  "properties": {
    "user_code": { "type": "string", "minLength": 1 },
    "company_code": { "type": "string", "minLength": 1 },
    "branch_code": { "type": "string", "minLength": 1 },
    "allowed_branch_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "origin_routine": { "type": ["string", "null"] },
    "erp_version": { "type": "string", "minLength": 1 }
  }
}
